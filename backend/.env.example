# Copy this file to .env and adjust for your machine.
# Nothing here is a real secret — these are local development defaults
# for the SIMULATION-MODE database only.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/omanone_sim

# Comma-separated list of origins allowed to call the API in dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulation defaults
SIM_TIMEZONE=Asia/Muscat
SIM_CURRENCY=OMR

# Phase 7 demo auth. SIMULATION MODE: this is a documented demo secret for
# signing demo-account JWTs, not production secrets management — change it
# for any deployment that isn't purely a local demo.
JWT_SECRET=omanone-sim-demo-secret-change-me
JWT_EXPIRE_MINUTES=480
